[Unit]
Description=Serveur des affiches (affiches/serveur.js)
After=network-online.target
Wants=network-online.target

[Service]
User=affiches
WorkingDirectory=/opt/affiches/depot/affiches
EnvironmentFile=/etc/affiches.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node serveur.js
Restart=always
RestartSec=5
# Le service lit son code et n'écrit que dans /var/lib/affiches : la liste des affiches en ligne, relue au démarrage
# (ProtectSystem=strict met /opt en lecture seule, le dossier personnel par défaut n'y était pas accessible).
StateDirectory=affiches
Environment=LISTE_DISQUE=/var/lib/affiches/liste-affiches.json
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
